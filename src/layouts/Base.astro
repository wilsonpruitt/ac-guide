---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Guide to Annual Conference</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="/styles/base.css" />
  </head>
  <body>
    <header class="site">
      <a class="brand" href="/">Guide to Annual Conference</a>
      <nav>
        <a href="/agenda">Agenda</a>
        <a href="/agencies">Agencies</a>
        <a href="/process">How it works</a>
        <a href="/motions">Motions</a>
        <a href="/questions">Questions</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site">
      <p>Río Texas Annual Conference · community-curated · <a href="https://riotexas.wrootlabs.com">the
        Atlas</a> for the numbers · a <a href="https://wrootlabs.com">Wroot Labs</a> guide.</p>
    </footer>
  </body>
</html>
