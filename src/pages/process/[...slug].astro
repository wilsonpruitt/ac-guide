---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('process');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const d = item.data;
const { Content } = await render(item);

const matches = (ref: string) => ref === item.id || ref.startsWith(item.id + '#');
const notes = (await getCollection('annotations')).filter(
  (n) => n.data.target.type === 'process' && matches(n.data.target.ref),
);
const qs = (await getCollection('questions')).filter(
  (q) => q.data.target.type === 'process' && matches(q.data.target.ref),
);

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title={d.title}>
  <p class="eyebrow">How it works</p>
  <h1>{d.title}</h1>
  <p>{d.summary}</p>
  {d.rulesRefs.length > 0 && (
    <p class="spine-meta"><dt>Standing Rules</dt><dd>{d.rulesRefs.map((r) => `Rule ${r}`).join(', ')}</dd></p>
  )}

  <article><Content /></article>

  {notes.length > 0 && (
    <section>
      <h2>Notes from the floor</h2>
      {notes.map((n) => (
        <div class="note">
          <p>{n.data.body}</p>
          <p class="who">— {n.data.author}, {fmt(n.data.date)}
            {n.data.endorsements.length > 0 && ` · confirmed by ${n.data.endorsements.length}`}</p>
        </div>
      ))}
    </section>
  )}

  {qs.length > 0 && (
    <section>
      <h2>Open questions</h2>
      {qs.map((q) => (
        <div class={`q ${q.data.status}`}>
          <p><strong>{q.data.question}</strong></p>
          {q.data.answer
            ? <p>{q.data.answer} <span class="who">— {q.data.answeredBy}</span></p>
            : <p class="who">Unanswered · asked by {q.data.askedBy}</p>}
        </div>
      ))}
    </section>
  )}
</Base>
